# Copy to .env and fill in. Never commit .env.

# idTool of the current "tour d'affectation" — changes each CROUS phase!
# Find it in the URL when searching: https://trouverunlogement.lescrous.fr/tools/<ID_TOOL>/search
ID_TOOL=47

# "telegram", "discord" or "both"
NOTIFIER=telegram

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Only needed if NOTIFIER is "discord" or "both"
DISCORD_WEBHOOK_URL=

# Optional overrides
# PAGE_SIZE=24
# STATE_FILE=state.json
# Hours between "still alive" heartbeat messages (0 disables)
# HEARTBEAT_HOURS=24
